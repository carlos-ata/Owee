// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
enum DebtStatus {
  @@type("pg/text@1")
  Active   = "A"
  Inactive = "I"
}

model User {
  id            String            @id(map: "user_pkey")
  name          String
  email         String            @unique(map: "user_email_key")
  emailVerified Boolean
  image         String?
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())
  lastNames     String
  status        String
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Account {
  id                    String             @id(map: "account_pkey")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString  @default(now())
  updatedAt             TimestamptzString
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_userId_fkey")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Session {
  id        String            @id(map: "session_pkey")
  expiresAt TimestamptzString
  token     String            @unique(map: "session_token_key")
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString
  ipAddress String?
  userAgent String?
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_userId_fkey")

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Verification {
  id         String            @id(map: "verification_pkey")
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

model Debt {
  id          Int            @id @default(autoincrement())
  creatorId   String         @map("creator_id")
  debtorId    String        @map("debtor_id")
  creditorId    String?      @map("creditor_id")
  reconciledIntoId Int?         @map("reconciled_into_id")  
  description String
  amount      Numeric(12, 2)
  
  isSettled   Boolean        @default(false) @map("is_settled")
  isConfirmed Boolean?       @map("is_confirmed")
  status      DebtStatus        
  createdAt   TimestamptzString        @map("created_at")
  updatedAt   TimestamptzString        @map("updated_at")

  creator User  @relation("DebtCreator", fields: [creatorId], references: [id])
  debtor  User @relation("DebtDebtor", fields: [debtorId], references: [id])
  creditor  User? @relation("DebtCreditor", fields: [creditorId], references: [id])
  reconciledInto Debt? @relation("DebtReconciliation", fields: [reconciledIntoId], references: [id])

  paymentDetails PaymentDetail[] @relation("PaymentDetailDebt")
  reconciledFrom Debt[] @relation("DebtReconciliation")


  @@index([creatorId])
  @@index([debtorId])
  @@index([creditorId])
  @@index([reconciledIntoId])
  @@check(expression: sql`amount > 0`, name: "debt_amount_positive")
  @@check(
    expression: sql`creditor_id IS NOT NULL OR is_confirmed IS TRUE`,
    name: "debt_no_creditor_is_confirmed"
  )
  @@check(expression: sql`reconciled_into_id IS NULL OR is_settled IS TRUE`, name: "debt_reconciled_is_settled")
  @@check(expression: sql`reconciled_into_id <> id`, name: "debt_not_reconciled_into_itself")
  @@map("debt")
}


model Payment {
  id          Int            @id @default(autoincrement())
  amount      Numeric(12, 2)
  isConfirmed Boolean?       @map("is_confirmed")
  creatorId   String         @map("creator_id")
  debtorId    String         @map("debtor_id")
  creditorId  String?      @map("creditor_id")
  status      DebtStatus        
  createdAt   TimestamptzString        @map("created_at")
  updatedAt   TimestamptzString        @map("updated_at")

  creator User  @relation("PaymentCreator", fields: [creatorId], references: [id])
  debtor  User @relation("PaymentDebtor", fields: [debtorId], references: [id])
  creditor  User? @relation("PaymentCreditor", fields: [creditorId], references: [id])

  details PaymentDetail[] @relation("PaymentDetailPayment")

  @@index([creatorId])
  @@index([debtorId])
  @@index([creditorId])
  @@check(expression: sql`amount > 0`, name: "payment_amount_positive")  
  @@check(
    expression: sql`creditor_id IS NOT NULL OR is_confirmed IS TRUE`,
    name: "payment_no_creditor_is_confirmed"
  )
  @@map("payment")
}

model PaymentDetail {
  id          Int            @id @default(autoincrement())
  paymentId   Int            @map("payment_id")  
  debtId      Int            @map("debt_id")  
  amount      Numeric(12, 2)      

  payment  Payment  @relation("PaymentDetailPayment", fields: [paymentId], references: [id])
  debt  Debt  @relation("PaymentDetailDebt", fields: [debtId], references: [id])

  @@index([paymentId])
  @@index([debtId])
  @@unique([paymentId, debtId])
  @@check(expression: sql`amount > 0`, name: "payment_detail_amount_positive")

  @@map("payment_detail")
}